# NASA FLAME Environment Configuration
# Copy this file to .env and set your Gemini API key (never commit .env to source control)

# Google Gemini API Key (Required only for generative LLM synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
# If unset, NASA FLAME runs in deterministic, grounded retrieval-only fallback mode.
GEMINI_API_KEY=AQ.Ab8RN6KMPtNThFLa8znXM6GeLUKxxMuzfgSS8TIJWIuXjwVkHA

# Supported Gemini Model (Default: gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-3.5-flash-lite
